export type SandboxKind='trigger'|'action'|'review'|'output';
export type SandboxNodeData={label:string;kind:SandboxKind;notes:string};
export type SandboxNode={id:string;type:'sandbox';position:{x:number;y:number};data:SandboxNodeData};
export type SandboxEdge={id:string;source:string;target:string};
export type SandboxGraph={version:1;nodes:SandboxNode[];edges:SandboxEdge[]};
export type SandboxNodeInput=Partial<SandboxNodeData>&{position?:{x:number;y:number}};
export type SandboxNodePatch={position?:{x:number;y:number};data?:Partial<SandboxNodeData>};
export type SandboxStorage={getItem(key:string):string|null;setItem(key:string,value:string):void};
export const SANDBOX_KEY:string;
export const MAX_NODES:40;
export const MAX_EDGES:80;
export const SANDBOX_KINDS:readonly SandboxKind[];
export function createSandboxGraph():SandboxGraph;
export function validateSandboxGraph(value:unknown):SandboxGraph;
export function readSandboxGraph(storage?:SandboxStorage):{graph:SandboxGraph|null;error:string|null};
export function saveSandboxGraph(graph:SandboxGraph,storage?:SandboxStorage):SandboxGraph;
export function addSandboxNode(graph:SandboxGraph,input?:SandboxNodeInput):SandboxGraph;
export function updateSandboxNode(graph:SandboxGraph,id:string,patch:SandboxNodePatch):SandboxGraph;
export function removeSandboxNodes(graph:SandboxGraph,ids:string[]):SandboxGraph;
export function connectSandboxEdge(graph:SandboxGraph,source:string,target:string):SandboxGraph;
export function removeSandboxEdges(graph:SandboxGraph,ids:string[]):SandboxGraph;
