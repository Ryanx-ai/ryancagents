export type ConnectorId='gmail'|'calendar'|'contacts'|'sheets'|'gohighlevel'|'studio'|'codex';
export type Outfit='standard'|'manager'|'designer';
export type DraftInput={name:string;description:string;workflow:{trigger:string;input:string;steps:string[];output:string};outfit:Outfit;requestedConnectors:ConnectorId[]};
export type AgentDraft=DraftInput&{schemaVersion:1;id:string;status:'draft';connectorVerification:'not_verified';activation:'unavailable';createdAt:string;updatedAt:string};
export type DraftStorage={getItem(key:string):string|null;setItem(key:string,value:string):void};
export type DraftRecovery={version:1;form:DraftInput;editing:AgentDraft|null;step:number;unlocked:number};
export type RecoveryStorage=DraftStorage&{removeItem(key:string):void};
export const AGENT_DRAFTS_KEY:string;
export const AGENT_DRAFT_RECOVERY_KEY:string;
export const MAX_AGENT_DRAFTS:number;
export const CONNECTOR_IDS:readonly ConnectorId[];
export const OUTFITS:readonly {id:Outfit;label:string}[];
export function validateAgentDraft(value:unknown):AgentDraft;
export function createAgentDraft(input:DraftInput,previous?:AgentDraft):AgentDraft;
export function readAgentDrafts(storage?:DraftStorage):{drafts:AgentDraft[];error:string|null};
export function saveAgentDraft(draft:AgentDraft,storage?:DraftStorage):AgentDraft[];
export function deleteAgentDraft(id:string,storage?:DraftStorage):AgentDraft[];
export function exportAgentDraft(draft:AgentDraft):string;
export function importAgentDraft(raw:string):AgentDraft;
export function canActivateAgentDraft(draft?:unknown):false;
export function readAgentDraftRecovery(storage?:RecoveryStorage):{recovery:DraftRecovery|null;error:string|null};
export function saveAgentDraftRecovery(value:DraftRecovery,storage?:RecoveryStorage):DraftRecovery;
export function clearAgentDraftRecovery(storage?:RecoveryStorage):void;
