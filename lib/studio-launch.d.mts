export const STUDIO_URL:'http://127.0.0.1:4174';
export const LAUNCHER_URL:'http://127.0.0.1:4175/studio/launch';
export const STUDIO_TICKET_TTL:number;
export const STUDIO_HQ_ORIGINS:readonly string[];
