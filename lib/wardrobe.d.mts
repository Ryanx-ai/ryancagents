export type Palette={jacket:string;shirt:string;pants:string};
export type ClothingPart=keyof Palette;
export type WardrobeOutfit='standard'|'manager'|'designer';
export type WardrobeAgentId='scheduler'|'outreach'|'contacts'|'manager'|'designer'|'proposal';
export type WardrobePreferences=Partial<Record<WardrobeAgentId,Palette>>;
export type WardrobeStorage={getItem(key:string):string|null;setItem(key:string,value:string):void};
export const WARDROBE_KEY:string;
export const WARDROBE_AGENT_IDS:readonly WardrobeAgentId[];
export const CLOTHING_PARTS:readonly ClothingPart[];
export const DEFAULT_PALETTES:Readonly<Record<WardrobeOutfit,Readonly<Palette>>>;
export const COLOR_PRESETS:Readonly<Record<ClothingPart,readonly {name:string;color:string}[]>>;
export function normalizePalette(value:unknown):Palette|null;
export function validatePalette(value:unknown):Palette;
export function wardrobeOutfit(agentId?:string):WardrobeOutfit;
export function defaultPalette(outfit?:WardrobeOutfit):Palette;
export function palettesEqual(a:unknown,b:unknown):boolean;
export function readWardrobePreferences(storage?:WardrobeStorage):{palettes:WardrobePreferences;error:string|null};
export function saveWardrobePreference(agentId:string,palette:Palette,storage?:WardrobeStorage):WardrobePreferences;
export function resetWardrobePreference(agentId:string,storage?:WardrobeStorage):WardrobePreferences;
